// Prisma Schema for SuperTom Telegram Mining Game
// Designed for Supabase PostgreSQL (Supports Transaction Pooler & Direct URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum DepositStatus {
  CREATED
  WAITING_FOR_PAYMENT
  PAYMENT_DETECTED
  DETECTING
  PENDING_CONFIRMATION
  CONFIRMING
  COMPLETED
  CONFIRMED
  SUCCESS
  EXPIRED
  FAILED
  PENDING
  REJECTED
  UNDERPAID
  OVERPAID
  UNIDENTIFIED
  INITIATED
  PENDING_PAYMENT
  HASH_SUBMITTED
  VERIFYING
  AWAITING_CONFIRMATIONS
  VERIFIED
  CREDITED
  UNDER_REVIEW
}

enum CurrencyType {
  POOPS
  USDT_TRC20
}

enum MissionCategory {
  DAILY
  SOCIAL
  REFERRAL
  SPECIAL
}

enum VerificationType {
  TELEGRAM_CHANNEL
  TELEGRAM_GROUP
  EXTERNAL_LINK
  GAME_ACTION
}

enum MissionStatus {
  START
  IN_PROGRESS
  VERIFY
  COMPLETED
  CLAIMED
}

enum SpinRewardType {
  POOPS
  BISCUIT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum LedgerType {
  MINING_SETTLEMENT
  MISSION_REWARD
  SPIN_REWARD
  REFERRAL_BONUS
  REFERRAL_COMMISSION
  BISCUIT_PURCHASE
  WITHDRAWAL_RESERVATION
  WITHDRAWAL_REFUND
  WITHDRAWAL_COMPLETED
  DEPOSIT_CREDIT
  ADMIN_ADJUSTMENT
  INSTANT_CASHBACK
  DAILY_CAMPAIGN_REWARD
}

// 1. Core Player Account
model User {
  id              String         @id @default(uuid())
  telegramId      BigInt         @unique
  username        String?
  firstName       String?
  lastName        String?
  photoUrl        String?
  languageCode    String?        @default("en")
  poopsBalance    BigInt         @default(0)
  level           Int            @default(1)
  levelTitle      String         @default("Feline Cadet")
  referralCode    String         @unique
  referredById    String?
  remainingWithdrawals Int      @default(0)
  hasUnlimitedWithdrawals Boolean @default(false)
  adWithdrawalsClaimed Int      @default(0)
  accountStatus   AccountStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  referrer        User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referees        User[]         @relation("UserReferrals")
  sessions        Session[]
  miningSettlement MiningSettlement?
  inventories     UserInventory[]
  feedingEvents   FeedingEvent[]
  userMissions    UserMission[]
  spinHistories   SpinHistory[]
  spinState       SpinState?
  sentReferrals   Referral[]     @relation("ReferrerRel")
  receivedReferral Referral?     @relation("RefereeRel")
  withdrawals     Withdrawal[]
  deposits        Deposit[]
  ledgerEntries   LedgerEntry[]
  wallets         UserWallet[]
  campaignParticipations UserCampaignParticipation[]
  adSessions      AdSession[]

  @@index([telegramId])
  @@index([referralCode])
  @@index([accountStatus])
}

// 2. Cryptographic Telegram Sessions
model Session {
  id               String    @id @default(uuid())
  userId           String
  tokenHash        String    @unique
  refreshTokenHash String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// 3. Server-Authoritative Mining Engine
model MiningSettlement {
  id                   String   @id @default(uuid())
  userId               String   @unique
  baseRatePerHour      Int      @default(10)
  boostRatePerHour     Int      @default(0)
  totalRatePerHour     Int      @default(10)
  unclaimedPoops       BigInt   @default(0)
  lastSettledAt        DateTime @default(now())
  maxAccumulationHours Int      @default(24)
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 4. Biscuit Store Catalog
model BiscuitProduct {
  id                     String        @id // "common", "silver", "gold", "diamond"
  name                   String
  costPoops              BigInt
  productionBoostPerHour Int
  currencyType           CurrencyType  @default(POOPS)
  badge                  String
  color                  String
  borderColor            String
  glowColor              String
  description            String
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())

  inventories            UserInventory[]
  feedingEvents          FeedingEvent[]
}

// 5. Player Biscuit Inventory
model UserInventory {
  id         String         @id @default(uuid())
  userId     String
  biscuitId  String
  quantity   Int            @default(0)
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  biscuit    BiscuitProduct @relation(fields: [biscuitId], references: [id])

  @@unique([userId, biscuitId])
  @@index([userId])
}

// 6. Cat Feeding Audit Log
model FeedingEvent {
  id             String         @id @default(uuid())
  userId         String
  biscuitId      String
  quantity       Int            @default(1)
  boostAdded     Int
  timestamp      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  biscuit        BiscuitProduct @relation(fields: [biscuitId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

// 7. Quest Catalogue
model Mission {
  id               String           @id
  title            String
  description      String
  rewardPoops      BigInt
  category         MissionCategory
  verificationType VerificationType @default(GAME_ACTION)
  icon             String           @default("Trophy")
  badge            String?
  actionUrl        String?
  channelId        String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  userMissions     UserMission[]
}

// 8. Player Quest Progress
model UserMission {
  id        String        @id @default(uuid())
  userId    String
  missionId String
  status    MissionStatus @default(START)
  progress  Int           @default(0)
  total     Int           @default(1)
  claimedAt DateTime?
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission       @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId])
  @@index([userId])
}

// 9. Lucky Wheel Milestone Cooldowns
model SpinConfiguration {
  id             String   @id // "milestone_1", "milestone_2", "milestone_3"
  milestoneOrder Int      @unique // 1, 2, 3
  cooldownHours  Int      // 2, 4, 8
  label          String
}

// 10. Progressive Wheel State
model SpinState {
  id                String   @id @default(uuid())
  userId            String   @unique
  currentMilestone  Int      @default(1)
  cycleCount        Int      @default(1)
  nextUnlockAt      DateTime
  claimedMilestones String   @default("[]") // JSON string of claimed milestone numbers
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 11. Cryptographic Spin Outcomes
model SpinHistory {
  id             String         @id @default(uuid())
  userId         String
  milestone      Int
  rewardType     SpinRewardType
  rewardAmount   BigInt?
  rewardBiscuitId String?
  claimedAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([claimedAt])
}

// 12. Referral Program Ledger
model Referral {
  id                   String         @id @default(uuid())
  referrerId           String
  refereeId            String         @unique
  rewardPoops          BigInt         @default(450)
  commissionPercent    Int            @default(10)
  totalCommissionPoops BigInt         @default(0)
  status               ReferralStatus @default(QUALIFIED)
  createdAt            DateTime       @default(now())

  referrer             User           @relation("ReferrerRel", fields: [referrerId], references: [id], onDelete: Cascade)
  referee              User           @relation("RefereeRel", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([refereeId])
}

// 12b. Pending Referral Attributions (recorded when referee taps /start in Telegram chat before opening bot)
model PendingReferral {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  referralCode String
  createdAt    DateTime @default(now())

  @@index([telegramId])
  @@index([referralCode])
}

// 13. USDT TRC20/TON/BEP20 Withdrawal Requests
model Withdrawal {
  id              String           @id @default(uuid())
  userId          String
  walletAddress   String
  amountPoops     BigInt
  amountUsdt      Decimal          @db.Decimal(18, 4)
  network         String           @default("TRC20")
  status          WithdrawalStatus @default(PENDING)
  txHash          String?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  adminNotes      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement    PayoutAnnouncement?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 14. Double-Entry Immutable Balance Audit Ledger
model LedgerEntry {
  id             String     @id @default(uuid())
  userId         String
  type           LedgerType
  amount         BigInt     // Positive = Credit, Negative = Debit
  balanceBefore  BigInt
  balanceAfter   BigInt
  referenceId    String?
  idempotencyKey String?    @unique
  description    String
  createdAt      DateTime   @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adSession      AdSession?

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([idempotencyKey])
}

// 15. Dynamic System Configuration
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// 16. Player Deposits
model Deposit {
  id                    String        @id @default(uuid())
  userId                String?
  amountUsdt            Decimal       @db.Decimal(18, 4)
  amountPoops           BigInt
  currency              String        @default("USDT")
  network               String        @default("TRC20")
  depositAddress        String?
  paymentReference      String?       // Memo or Telegram ID for auto-credit
  expectedCryptoAmount  Decimal?      @db.Decimal(28, 8)
  receivedCryptoAmount  Decimal?      @db.Decimal(28, 8)
  txHash                String?       @unique
  status                DepositStatus @default(WAITING_FOR_PAYMENT)
  confirmations         Int           @default(0)
  requiredConfirmations Int           @default(1)
  blockNumber           BigInt?
  fromAddress           String?
  tokenContract         String?
  verifiedAt            DateTime?
  creditedAt            DateTime?
  failureReason         String?
  rewardAmount          Decimal?      @db.Decimal(18, 4)
  explorerUrl           String?
  notes                 String?
  confirmedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
  @@index([createdAt])
  @@index([fromAddress])
}

// 17. Authenticated Administrative Staff
model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auditLogs    AdminAuditLog[]

  @@index([email])
  @@index([role])
}

// 18. Administrative Immutable Audit Trail
model AdminAuditLog {
  id           String      @id @default(uuid())
  adminId      String
  action       String
  targetEntity String
  targetId     String?
  previousValue String?    @db.Text
  newValue     String?     @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  admin        AdminUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([targetEntity])
  @@index([createdAt])
}

// 19. User Saved Receiving Wallets
model UserWallet {
  id            String   @id @default(uuid())
  userId        String
  network       String   @default("TRC20")
  walletAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network, walletAddress])
  @@index([userId])
}

// 20. Community Milestones & Deposit Campaigns
model Campaign {
  id                     String                      @id @default(uuid())
  slug                   String                      @unique @default("5k_members_celebration")
  title                  String                      @default("5K Members Celebration")
  description            String?                     @default("Special Achievement Rewards celebrating 5,000 Telegram Members!")
  isActive               Boolean                     @default(true)
  minDepositUsdt         Decimal                     @default(5.0) @db.Decimal(18, 4)
  maxDepositUsdt         Decimal                     @default(10.0) @db.Decimal(18, 4)
  cashbackPercent        Decimal                     @default(30.0) @db.Decimal(5, 2)
  dailyRewardPoops       BigInt                      @default(2000)
  minRewardDays          Int                         @default(5)
  maxRewardDays          Int                         @default(13)
  allowMultipleCashbacks Boolean                     @default(false)
  startDate              DateTime                    @default(now())
  endDate                DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  participations         UserCampaignParticipation[]
  dailyRewards           CampaignDailyReward[]

  @@index([slug])
  @@index([isActive])
}

// 21. User Campaign Participation & Reward Schedule
model UserCampaignParticipation {
  id                      String                @id @default(uuid())
  userId                  String
  campaignId              String
  qualifyingDepositId     String?
  qualifyingDepositAmount Decimal               @db.Decimal(18, 4)
  cashbackPoops           BigInt
  cashbackCreditedAt      DateTime              @default(now())
  totalRewardDays         Int
  daysClaimed             Int                   @default(0)
  totalDailyPoopsCredited BigInt                @default(0)
  rewardStartAt           DateTime              @default(now())
  rewardEndAt             DateTime
  nextRewardAt            DateTime
  status                  String                @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign                Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dailyRewards            CampaignDailyReward[]

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([nextRewardAt])
}

// 22. Daily Distributed Campaign Rewards Log
model CampaignDailyReward {
  id              String                    @id @default(uuid())
  participationId String
  userId          String
  campaignId      String
  dayIndex        Int                       // 1, 2, ... up to totalRewardDays
  rewardDate      String                    // "YYYY-MM-DD" in UTC
  rewardPoops     BigInt                    @default(2000)
  status          String                    @default("COMPLETED") // COMPLETED, FAILED
  ledgerEntryId   String?
  processedAt     DateTime                  @default(now())

  participation   UserCampaignParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  campaign        Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId, rewardDate])
  @@index([userId])
  @@index([campaignId])
  @@index([rewardDate])
  @@index([participationId])
}

// 23. Payout Channel Automation Configuration
model PayoutChannelConfig {
  id                   String    @id @default(uuid())
  referenceChannel     String?   @default("https://t.me/payouts")
  destinationChannel   String    @default("https://t.me/+W9ypwO2_Pm0xZTJl")
  destinationChatId    String?
  referenceStatus      String    @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  destinationStatus    String    @default("CONFIGURED") // VERIFIED, CONFIGURED, PERMISSION_MISSING, ERROR
  automationEnabled    Boolean   @default(false)
  publishingMode       String    @default("MANUAL_APPROVAL") // AUTOMATIC, MANUAL_APPROVAL
  autoReflectReference Boolean   @default(true)
  activeTemplateId     String?
  lastSyncAt           DateTime?
  lastPublishedAt      DateTime?
  lastPublishedTxHash  String?
  lastPublishedAmount  Decimal?  @db.Decimal(18, 4)
  failedAttemptsCount  Int       @default(0)
  totalPublishedCount  Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// 24. Payout Announcement Templates
model PayoutMessageTemplate {
  id               String               @id @default(uuid())
  name             String
  description      String?
  heading          String               @default("✅ SuperTom Withdrawal Complete")
  successMessage   String               @default("Payment successfully sent to user on-chain!")
  footer           String               @default("🐱 Thank you for mining with SuperTom! Join @SuperTomCare for support.")
  emojis           String               @default("💎,💰,🚀,🐱,✅,🔗")
  currencyDisplay  String               @default("USDT")
  showUsd          Boolean              @default(true)
  showPoops        Boolean              @default(true)
  showExplorerLink Boolean              @default(true)
  maskUserAddress  Boolean              @default(true)
  rawTemplate      String?              @db.Text
  isDefault        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  announcements    PayoutAnnouncement[]
}

// 25. Payout Announcement Records
model PayoutAnnouncement {
  id                String                 @id @default(uuid())
  withdrawalId      String?                @unique
  source            String                 @default("SUPERTOM_PAYOUT") // SUPERTOM_PAYOUT, REFERENCE_CHANNEL
  referencePostId   String?
  userId            String?
  templateId        String?
  network           String                 @default("TRC20")
  currency          String                 @default("USDT")
  amountCrypto      Decimal                @db.Decimal(18, 4)
  amountUsdt        Decimal                @db.Decimal(18, 4)
  amountPoops       BigInt                 @default(0)
  walletAddress     String
  txHash            String
  explorerUrl       String?
  recipientMasked   String
  renderedMessage   String                 @db.Text
  telegramMessageId BigInt?
  telegramChatId    String?
  status            String                 @default("PENDING_APPROVAL") // PENDING_APPROVAL, PUBLISHED, REJECTED, FAILED
  failureReason     String?
  publishedAt       DateTime?
  publishedBy       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  withdrawal        Withdrawal?            @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  template          PayoutMessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([txHash])
}

// 26. Payout Automation Activity & Audit Logs
model PayoutAutomationLog {
  id        String   @id @default(uuid())
  eventType String   // CHANNEL_VERIFIED, ANNOUNCEMENT_PUBLISHED, ANNOUNCEMENT_QUEUED, PUBLISH_FAILED, CONFIG_UPDATED, FORMAT_EXTRACTED
  status    String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  message   String
  details   Json?
  adminId   String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

// TON Payment Configuration (admin-managed)
model TonPaymentConfig {
  id                      String   @id @default("singleton")
  tonReceivingAddress     String   @default("UQBGdgDogsxtpbFIvzAFnIByU3E3PlXsdkt_xyuG4S-gzvgR")
  requiredConfirmations   Int      @default(1)
  depositExpiryMinutes    Int      @default(1440)
  minDepositTon           Float    @default(0.1)
  maxDepositTon           Float    @default(10000.0)
  monitoringEnabled       Boolean  @default(true)
  tonConnectManifestUrl   String   @default("https://super-tom.vercel.app/tonconnect-manifest.json")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// 27. Rewarded Advertisement Sessions
enum AdSessionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model AdSession {
  id                String          @id @default(uuid())
  userId            String
  provider          String          @default("adexium") // "adexium"
  placementId       String          // "dd81f1ec-401b-498c-a2f3-0a4bb0032b59"
  status            AdSessionStatus @default(PENDING)
  isCompleted       Boolean         @default(false)
  rewardAmount      BigInt          @default(0)
  rewardLedgerId    String?         @unique
  sessionNonce      String          @unique
  sessionTokenHash  String?
  ipAddress         String?
  userAgent         String?
  viewDurationMs    Int?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  expiresAt         DateTime

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardLedger      LedgerEntry?    @relation(fields: [rewardLedgerId], references: [id])

  @@index([userId, status])
  @@index([createdAt])
  @@index([expiresAt])
}


