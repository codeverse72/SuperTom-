# ===============================================================
# SuperTom Backend - Production Environment Variables
# ===============================================================
# Configure these variables in your Render Dashboard for production.
# For local development, copy this file to server/.env
# ===============================================================

# Server Environment & Port
NODE_ENV="production"
PORT="5000"
HOST="0.0.0.0"

# ---------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# ---------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string
# 1. DATABASE_URL: Transaction Pooler connection string (Port 6543)
#    Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.yourprojectref:yourdbpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Session connection string (Port 5432, for migrations)
#    Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.yourprojectref:yourdbpassword@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Telegram Bot Credentials
# ---------------------------------------------------------------
# Required for cryptographic HMAC-SHA256 signature verification & membership check
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_BOT_USERNAME="SuperrTombot"

# ---------------------------------------------------------------
# Security & JWT Secrets
# ---------------------------------------------------------------
# Generate secure 64-character random strings (e.g. openssl rand -hex 32)
JWT_SECRET="supertom_jwt_production_secret_key_minimum_64_characters_long_xyz_2026"
JWT_REFRESH_SECRET="supertom_jwt_refresh_production_secret_key_minimum_64_chars_long_abc_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------------------------------------------------------------
# Client / CORS
# ---------------------------------------------------------------
# Your Vercel frontend domain (or comma-separated domains)
FRONTEND_URL="https://super-tom.vercel.app,https://web.telegram.org"

# ---------------------------------------------------------------
# Game Economy & Tokenomics
# ---------------------------------------------------------------
POOPS_PER_USDT="2000"
MIN_WITHDRAWAL_POOPS="2000"
MINING_BASE_RATE="10"
REFERRAL_SIGNUP_BONUS_POOPS="2000"
REFERRAL_COMMISSION_PERCENT="10"

