# =====================================================
# SuperTom Telegram Mini App - Environment Variables
# =====================================================
# Copy this file to .env for local development.
# Configure matching values in Vercel Dashboard for production.
# =====================================================

# === Backend API Connection ===
# Base URL for the future Render backend REST API.
# Leave empty or omit entirely for frontend-only preview mode.
VITE_API_BASE_URL=""

# === Telegram Bot Configuration ===
# Your Telegram Bot username (without @), used for deep links and referral URLs.
# Replace with your actual bot username once created via @BotFather.
VITE_TELEGRAM_BOT_USERNAME="SuperTomBot"

# === Feature Availability Flags ===
# All features default to "false" (unavailable) until the Render backend is connected.
# Set to "true" only after the corresponding backend endpoint is live and tested.
VITE_FEATURE_MINING="false"
VITE_FEATURE_STORE="false"
VITE_FEATURE_FEEDING="false"
VITE_FEATURE_SPIN="false"
VITE_FEATURE_SPIN_SYNC="false"
VITE_FEATURE_MISSION_VERIFY="false"
VITE_FEATURE_MISSION_CLAIM="false"
VITE_FEATURE_REFERRALS="false"
VITE_FEATURE_WITHDRAWALS="false"
VITE_FEATURE_HISTORY="false"
